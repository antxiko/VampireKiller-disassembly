C 0x802D lee el tipo de la cosa
C 0x804E sonido: arranca la musica o el efecto A (bit 7 = musica)
C 0x8051 lee el tipo de la cosa
C 0x8062 hl_mas_a: HL += A
C 0x806A guarda la vida de la cosa
C 0x8088 lee el tipo de la cosa
C 0x8098 lee la vida del enemigo (barra ENEMY)
