# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0x8964 reproductor
L 0x89CE canal_en_reposo
L 0x8A0B volumen_del_canal
C 0x8964 lee la copia del registro 7 del PSG (el mezclador)
C 0x896D lee las banderas del sonido (bit 0 pausa, bit 1 ...)
